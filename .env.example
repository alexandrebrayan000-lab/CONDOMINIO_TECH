# Banco de Dados Neon (PostgreSQL)
DATABASE_URL="postgresql://usuario:senha@host/neondb?sslmode=require&channel_binding=require"

# URL da Aplicação (usada para montar os links nos e-mails)
# Em desenvolvimento: http://localhost:3000
# Em produção: https://seu-dominio.com.br ou https://seu-projeto.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# CONFIGURAÇÃO DE E-MAIL (Escolha UMA das opções abaixo)
# ==============================================================================

# ------------------------------------------------------------------------------
# OPÇÃO 1: GMAIL (Recomendado para início rápido e gratuito)
# Como obter a senha:
# 1. Acesse https://myaccount.google.com/security
# 2. Ative a "Verificação em duas etapas" (se ainda não tiver)
# 3. Pesquise por "Senhas de app" (App Passwords)
# 4. Crie uma nova senha de app com o nome "CondominioTech"
# 5. Copie a senha de 16 letras gerada e cole em EMAIL_SERVER_PASSWORD (sem espaços)
# ------------------------------------------------------------------------------
# EMAIL_SERVICE="gmail"
# EMAIL_SERVER_USER="seu-email@gmail.com"
# EMAIL_SERVER_PASSWORD="xxxx xxxx xxxx xxxx"
# EMAIL_FROM="\"CondomínioTech\" <seu-email@gmail.com>"

# ------------------------------------------------------------------------------
# OPÇÃO 2: SERVIDOR SMTP PADRÃO (Hostinger, cPanel, Locaweb, Brevo, SendGrid, etc.)
# ------------------------------------------------------------------------------
# EMAIL_SERVER_HOST="smtp.exemplo.com"
# EMAIL_SERVER_PORT="587"
# EMAIL_SERVER_SECURE="false" # "true" para porta 465, "false" para porta 587
# EMAIL_SERVER_USER="contato@seudominio.com"
# EMAIL_SERVER_PASSWORD="sua-senha-aqui"
# EMAIL_FROM="\"CondomínioTech\" <contato@seudominio.com>"

# ------------------------------------------------------------------------------
# OPÇÃO 3: BREVO (Antigo Sendinblue - gratuito até 300 e-mails/dia sem limites de porta)
# ------------------------------------------------------------------------------
# EMAIL_SERVER_HOST="smtp-relay.brevo.com"
# EMAIL_SERVER_PORT="587"
# EMAIL_SERVER_SECURE="false"
# EMAIL_SERVER_USER="seu-login-smtp-brevo"
# EMAIL_SERVER_PASSWORD="sua-chave-smtp-brevo"
# EMAIL_FROM="\"CondomínioTech\" <email-validado-no-brevo@dominio.com>"

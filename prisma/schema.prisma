generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MORADOR
  SINDICO
  PORTARIA
}

model User {
  id          String    @id @default(uuid())
  nome        String
  email       String    @unique
  senha       String
  tipo        Role      @default(MORADOR)
  bloco       String
  apartamento String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt @default(now())

  reservas    Reserva[]
}

model Espaco {
  id          String    @id @default(uuid())
  nome        String
  descricao   String?
  capacidade  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt @default(now())
  
  reservas    Reserva[]
}

model Reserva {
  id          String   @id @default(uuid())
  espacoId    String
  espaco      Espaco   @relation(fields: [espacoId], references: [id])
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  nomeMorador String
  data        DateTime
  horario     String?  // <--- Tornou-se opcional (?) para não quebrar registros antigos
  createdAt   DateTime @default(now())
}

model Aviso {
  id        String   @id @default(uuid())
  titulo    String
  conteudo  String
  createdAt DateTime @default(now())
}
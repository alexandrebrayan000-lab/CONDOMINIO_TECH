generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Espaco {
  id          String    @id @default(uuid())
  nome        String
  descricao   String
  capacidade  Int
  reservas    Reserva[]
  createdAt   DateTime  @default(now())
}

model Reserva {
  id          String   @id @default(uuid())
  espacoId    String
  espaco      Espaco   @relation(fields: [espacoId], references: [id])
  nomeMorador String
  data        DateTime
  createdAt   DateTime @default(now())
}